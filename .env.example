# Порт (Render задаёт сам)
PORT=

# ── База данных ────────────────────────────────────────────────────
# PostgreSQL (Neon). Если задан — используется он; иначе локальный PGlite (./.pglite).
# Взять в панели Neon → Project → Connection string (Pooled).
DATABASE_URL=

# ── Аккаунт владельца (дядя) ──────────────────────────────────────
# Создаётся автоматически при первом старте, если заданы оба поля.
OWNER_PHONE=
OWNER_PASSWORD=
OWNER_NAME=Владелец

# ── Telegram-уведомления о заказах ────────────────────────────────
# TELEGRAM_BOT_TOKEN — токен бота. Чек уходит на CHAT_ID (владелец проекта).
# Если CHAT_ID не задан — по умолчанию 6635199967 (ID владельца).
TELEGRAM_BOT_TOKEN=
CHAT_ID=

# ── Мини-приложение (кнопка «Открыть меню» в боте) ─────────────────
TMA_URL=

# ── Юзернейм менеджера (раздел «По вопросам» в /help) ─────────────
MANAGER_USERNAME=mansurov_dev
